{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|apply_patch|functions.apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/env-file-guard.js"
          }
        ]
      },
      {
        "matcher": "Bash|shell_command|functions.shell_command|exec_command|functions.exec_command",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/git-commit-guard.js"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|apply_patch|functions.apply_patch",
        "hooks": [
          {
            "type": "command",
            "command": "node .codex/hooks/edited-file-check.js"
          }
        ]
      }
    ]
  }
}
